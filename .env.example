# Copy to `.env` in the repository root and replace every CHANGE_ME value.
# Docker Compose reads this file automatically. Never commit `.env` (it is in
# .gitignore). Placeholders only below: no real secret belongs in this file.
# See SECURITY.md for what each setting protects.

# --- Mode ---------------------------------------------------------------------
# production  : refuses to start on a placeholder/weak secret or SQLite, keeps
#               CORS closed, turns /docs off. docker-compose.yml sets this.
# development : a local `uvicorn --reload` run; problems are only warnings.
# FORIFLOW_ENV=production

# --- PostgreSQL (required for the Docker pilot stack) -------------------------
POSTGRES_USER=foriflow
# At least 12 characters, unique to this install. Production refuses empty
# values, this placeholder and well-known defaults (postgres, password, ...).
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=foriflow
# Tools on the laptop use localhost. Compose overrides POSTGRES_HOST to `db`.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Optional full SQLAlchemy URL. When set, it wins over the POSTGRES_* parts.
# Encode reserved characters in the password (e.g. @, :, /).
# FORIFLOW_DATABASE_URL=postgresql+psycopg2://foriflow:CHANGE_ME_POSTGRES_PASSWORD@db:5432/foriflow

# --- Application --------------------------------------------------------------
FORIFLOW_SCORING_ENGINE=auto
FORIFLOW_LOG_LEVEL=INFO
# Interactive API docs (/docs, /redoc, /openapi.json). Unset: on in
# development, off in production. Set true only while you need them.
# FORIFLOW_ENABLE_DOCS=false

# Browser origins allowed to call the API directly (comma separated, no "*").
# Unset is right for the Docker stack: the dashboard and API share one origin.
# FORIFLOW_CORS_ORIGINS=https://foriflow.yourbank.example

# Largest request body in bytes (default 3 MiB; the statement CSV is the
# largest legitimate request).
# FORIFLOW_MAX_BODY_BYTES=3145728

# Largest facility (PKR) a manager may approve alone, for the FIRST credit
# policy only: it is read once, when the demo policy is created. After that the
# limit lives in the policy (Credit Policy page) and this value is ignored.
# MANAGER_APPROVAL_LIMIT_PKR=2000000

# --- Auth (JWT, on-premise only) -----------------------------------------------
# Regenerate per deploy. At least 32 characters (HMAC-SHA256); the API refuses
# to sign tokens with a shorter value or with this placeholder, and production
# refuses to start. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Changing it signs every officer out.
JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET_KEY_AT_LEAST_32_CHARS
# Session length in minutes (15 to 720; default 480 = 8 hours).
# FORIFLOW_JWT_EXPIRE_MINUTES=480

FORIFLOW_ADMIN_USERNAME=admin
# Used only by: python -m scripts.seed_admin  (from backend/, or docker compose exec)
# 12-72 characters, not common, not a sequence, not containing the username.
# Docker passes .env into the API container, so delete this line again once
# the first admin exists.
FORIFLOW_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
