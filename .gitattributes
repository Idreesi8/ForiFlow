# Shell scripts and container configs must keep LF endings. Checked out with
# CRLF on Windows, bash inside a Linux image fails with "\r: command not found"
# and nginx rejects the config.
*.sh text eol=lf
Dockerfile text eol=lf
*.conf text eol=lf
*.yml text eol=lf

# PowerShell is happiest with CRLF on Windows.
*.ps1 text eol=crlf
*.bat text eol=crlf

# Trained artefacts are binary; never line-ending-normalise or diff them.
*.pkl binary

# Research provenance records exact bytes, including JSON newlines. These
# generated model sidecars are immutable artefacts, like the pickle files.
backend/ml/feature_names.json binary
backend/ml/applicability_model.json binary
